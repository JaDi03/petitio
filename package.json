{
  "name": "petitio",
  "version": "0.1.0",
  "private": true,
  "description": "A personal agent on Fly.io Sprites that follows a cancelled flight claim until the airline pays.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"**/*.test.ts\"",
    "agent:try": "tsx agent/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "dependencies": {
    "ollama": "0.6.4",
    "zod": "4.6.7"
  }
}

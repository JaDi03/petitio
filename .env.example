# Petitio settings. On the Sprite this file lives at ~/petitio-data/.env (mode 600), never in the repo.

# Port the HTTP service listens on inside the Sprite (sprite-env services --http-port)
PORT=8080
# Folder for the case database
DATA_DIR=/home/sprite/petitio-data
# Public URL of your Sprite (sprite info), used to register the Telegram webhook
PUBLIC_URL=https://your-sprite-name-your-org-id.sprites.app

# Connector ids from your Fly.io dashboard (Sprites > Connectors). Keys stay in the connectors.
OLLAMA_CONNECTOR_ID=your-ollama-connector-id
OLLAMA_MODEL=deepseek-v4-pro:0813
TELEGRAM_CONNECTOR_ID=your-telegram-custom-api-connector-id

# Who the agent works for
OWNER_EMAILS=you@example.com
OWNER_CHAT_ID=your-telegram-chat-id
AGENTMAIL_INBOX=your-inbox@agentmail.to

# Webhook secrets: set with scripts/sprite-deploy.sh (Telegram, generated) and by pasting the
# AgentMail signing secret when the script asks for it
TELEGRAM_WEBHOOK_SECRET=generated-by-the-deploy-script
AGENTMAIL_WEBHOOK_SECRET=whsec_your-agentmail-signing-secret

MAX_RUNS_PER_DAY=30

# The airline this deployment files claims with. Off until you set all four (without them the
# agent only advises). Set each with: node scripts/set-setting.mjs <NAME>
# AGENTMAIL_CONNECTOR_ID=your-agentmail-connector-id
# AIRLINE_NAME=Demo Air
# AIRLINE_EMAIL=airline-claims@example.com
# AIRLINE_FORM_URL=https://demo-air.vercel.app/
